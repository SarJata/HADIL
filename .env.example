# Copy to a local .env or set these in the Render dashboard.
# Never commit real credentials.

# desktop | cloud
HADIL_DEPLOYMENT_MODE=desktop

# Required in cloud: non-default JWT signing secret
# HADIL_JWT_SECRET=

# Cloud metadata database (HADIL users/roles/config — not customer databases)
# HADIL_METADATA_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres
# HADIL_METADATA_POOL_MODE=default
# HADIL_METADATA_POOL_MODE=null

# Desktop/local metadata SQLite path override (also used by tests)
# HADIL_METADATA_DB=./hadil_metadata.db

# Writable runtime data (logs, policy files, embedding cache)
# HADIL_DATA_DIR=

# CORS: comma-separated origins. Never use *. Cloud also adds RENDER_EXTERNAL_URL when present.
# HADIL_ALLOWED_ORIGINS=https://your-service.onrender.com

# Optional frontend split-deploy API origin. Leave unset for same-origin Render/EXE.
# VITE_API_URL=

# MiniLM / RAG
# HADIL_EMBEDDING_MODEL_PATH=
# HADIL_EMBEDDING_CACHE_DIR=
# HADIL_POLICY_STORAGE_DIR=
# HADIL_POLICY_THRESHOLD=0.65

# Optional Render bind overrides (PORT is provided by Render)
# HOST=0.0.0.0
# PORT=8000
